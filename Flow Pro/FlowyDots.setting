					Name = "Color",
					ControlGroup = 5,
					Default = 0,
					Page = "Background",
				},
				BGTLGreen = InstanceInput {
					SourceOp = "BGColor",
					Source = "TopLeftGreen",
					ControlGroup = 5,
					Default = 0,
					Page = "Background",
				},
				BGTLBlue = InstanceInput {
					SourceOp = "BGColor",
					Source = "TopLeftBlue",
					ControlGroup = 5,
					Default = 0,
					Page = "Background",
				},
				BGTRRed = InstanceInput {
					SourceOp = "BGColor",
					Source = "TopRightRed",
					Name = "Color 2 (TR)",
					ControlGroup = 6,
					Default = 0,
					Page = "Background",
				},
				BGTRGreen = InstanceInput {
					SourceOp = "BGColor",
					Source = "TopRightGreen",
					ControlGroup = 6,
					Default = 0,
					Page = "Background",
				},
				BGTRBlue = InstanceInput {
					SourceOp = "BGColor",
					Source = "TopRightBlue",
					ControlGroup = 6,
					Default = 0,
					Page = "Background",
				},
				BGBLRed = InstanceInput {
					SourceOp = "BGColor",
					Source = "BottomLeftRed",
					Name = "Color 3 (BL)",
					ControlGroup = 7,
					Default = 0,
					Page = "Background",
				},
				BGBLGreen = InstanceInput {
					SourceOp = "BGColor",
					Source = "BottomLeftGreen",
					ControlGroup = 7,
					Default = 0,
					Page = "Background",
				},
				BGBLBlue = InstanceInput {
					SourceOp = "BGColor",
					Source = "BottomLeftBlue",
					ControlGroup = 7,
					Default = 0,
					Page = "Background",
				},
				BGBRRed = InstanceInput {
					SourceOp = "BGColor",
					Source = "BottomRightRed",
					Name = "Color 4 (BR)",
					ControlGroup = 8,
					Default = 0,
					Page = "Background",
