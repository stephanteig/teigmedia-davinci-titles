				},
				DotBLRed = InstanceInput {
					SourceOp = "DotColor",
					Source = "BottomLeftRed",
					Name = "Color 3 (BL)",
					ControlGroup = 3,
					Default = 0,
					Page = "Dots",
				},
				DotBLGreen = InstanceInput {
					SourceOp = "DotColor",
					Source = "BottomLeftGreen",
					ControlGroup = 3,
					Default = 0,
					Page = "Dots",
				},
				DotBLBlue = InstanceInput {
					SourceOp = "DotColor",
					Source = "BottomLeftBlue",
					ControlGroup = 3,
					Default = 0,
					Page = "Dots",
				},
				DotBRRed = InstanceInput {
					SourceOp = "DotColor",
					Source = "BottomRightRed",
