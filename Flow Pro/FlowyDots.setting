							Source = "Output",
						},
						PerformDepthMerge = Input { Value = 0, }
					},
					ViewInfo = OperatorInfo { Pos = { 248, 99 } },
				},
				BGImageMerge = Merge {
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "BGLoaderMerge",
							Source = "Output",
						},
						PerformDepthMerge = Input { Value = 0, }
					},
					ViewInfo = OperatorInfo { Pos = { 275, 82.5 } },
				},
				FinalMerge = Merge {
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "BGImageMerge",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "DotsTransform",
							Source = "Output",
						},
						PerformDepthMerge = Input { Value = 0, }
					},
					ViewInfo = OperatorInfo { Pos = { 330, 82.5 } },
				}
			},
			UserControls = ordered() {
				DotSize = {
					LINKS_Name = "Dot Size",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_MinScale = 0.001,
