			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "FinalMerge",
					Source = "Output",
				}
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				DotPath = PolylineMask {
					DrawMode = "InsertAndModify",
					DrawMode2 = "InsertAndModify",
					NameSet = true,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						SoftEdge = Input { Value = 0, },
						BorderWidth = Input {
							Value = 0.016,
							Expression = "FlowyDots.DotSize",
						},
						PaintMode = Input { Value = FuID { "Minimum" }, },
						WritePosition = Input {
							Value = 0,
							Expression = ":p = (time / FlowyDots.LoopFrames) % 1; if FlowyDots.Reverse > 0.5 then p = 1 - p end; local e = FlowyDots.Easing; if e == 1 then p = p*p elseif e == 2 then p = 1-(1-p)^2 elseif e == 3 then p = p*p*(3-2*p) end; return p",
						},
						WriteLength = Input { Value = 0, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						ClippingMode = Input { Value = FuID { "None" }, },
						Polyline = Input {
							Value = Polyline {
								Points = {
									{ Linear = true, X = -0.307417974322397, Y = 0.418884664131812, RX = 0.188777936281503, RY = -0.0785804816223067 },
									{ Linear = true, X = 0.258915834522111, Y = 0.183143219264892, LX = -0.188777936281503, LY = 0.0785804816223067, RX = -0.149786019971469, RY = -0.174904942965779 },
									{ Linear = true, X = -0.190442225392297, Y = -0.341571609632446, LX = 0.149786019971469, LY = 0.174904942965779, RX = 0.00523062291963861, RY = 0.124207858048162 },
									{ Linear = true, X = -0.174750356633381, Y = 0.0310519645120405, LX = -0.00523062291963861, LY = -0.124207858048162 }
								}
							},
						},
						Polyline2 = Input {
							Value = Polyline {
							},
							Disabled = true,
						}
					},
					ViewInfo = OperatorInfo { Pos = { 0, 16.5 } },
				},
				DotColor = Background {
					NameSet = true,
					Inputs = {
						EffectMask = Input {
							SourceOp = "DotPath",
							Source = "Mask",
						},
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						GlobalIn = Input { Value = -10000, },
						GlobalOut = Input { Value = 10000, },
						TopLeftRed = Input { Value = 0.372549019607843, },
						TopLeftGreen = Input { Value = 0.745098039215686, },
						TopLeftBlue = Input { Value = 0.92156862745098, },
						TopRightRed = Input { Value = 1, },
						TopRightGreen = Input { Value = 1, },
						TopRightBlue = Input { Value = 1, },
						BottomLeftRed = Input { Value = 0, },
						BottomLeftGreen = Input { Value = 0, },
						BottomLeftBlue = Input { Value = 0, },
						BottomRightRed = Input { Value = 1, },
						BottomRightGreen = Input { Value = 0, },
						BottomRightBlue = Input { Value = 0, }
					},
					ViewInfo = OperatorInfo { Pos = { 110, 16.5 } },
				},
				Duplicator = Fuse.Duplicate {
					NameSet = true,
					Inputs = {
						Copies = Input {
							Value = 50,
							Expression = "FlowyDots.DotCount",
						},
						TimeOffset = Input {
							Value = -3,
							Expression = "-(FlowyDots.LoopFrames / FlowyDots.DotCount)",
						},
						Polyline = Input {
							Value = Polyline {
							},
						},
						Background = Input {
							SourceOp = "DotColor",
							Source = "Output",
						}
					},
					ViewInfo = OperatorInfo { Pos = { 220, 16.5 } },
				},
				Duplicator2 = Fuse.Duplicate {
					NameSet = true,
					Inputs = {
						Copies = Input {
							Value = 50,
							Expression = "FlowyDots.DotCount",
						},
						TimeOffset = Input {
							Value = 3,
							Expression = "FlowyDots.LoopFrames / FlowyDots.DotCount",
						},
						Polyline = Input {
							Value = Polyline {
							},
						},
						Background = Input {
							SourceOp = "DotColor",
							Source = "Output",
						}
					},
					ViewInfo = OperatorInfo { Pos = { 220, 49.5 } },
				},
				MergeDots = Merge {
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Duplicator",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Duplicator2",
							Source = "Output",
						},
						PerformDepthMerge = Input { Value = 0, }
					},
					ViewInfo = OperatorInfo { Pos = { 275, 33 } },
				},
				Glow = SoftGlow {
					NameSet = true,
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						Gain = Input { Value = 2, },
						XGlowSize = Input { Value = 0.05, },
						Blend = Input {
							Value = 1,
							Expression = "FlowyDots.GlowEnabled",
						},
						Input = Input {
							SourceOp = "MergeDots",
							Source = "Output",
						}
					},
					ViewInfo = OperatorInfo { Pos = { 330, 16.5 } },
				},
				DotsTransform = Transform {
					NameSet = true,
					Inputs = {
						Input = Input {
							SourceOp = "Glow",
							Source = "Output",
						}
					},
					ViewInfo = OperatorInfo { Pos = { 385, 16.5 } },
				},
				BGColor = Background {
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input {
							Value = 0,
							Expression = "FlowyDots.BGEnabled",
						}
					},
					ViewInfo = OperatorInfo { Pos = { 220, 82.5 } },
				},
				BGLoader = Loader {
					Clips = ordered() {
					},
					NameSet = true,
					Inputs = {
						MissingFrames = Input { Value = 1, }
					},
					ViewInfo = OperatorInfo { Pos = { 220, 115.5 } },
				},
				BGTransform = Transform {
					NameSet = true,
					Inputs = {
						Input = Input {
							SourceOp = "BGLoader",
							Source = "Output",
						}
					},
					ViewInfo = OperatorInfo { Pos = { 248, 115.5 } },
				},
				BGLoaderMerge = Merge {
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "BGColor",
							Source = "Output",
