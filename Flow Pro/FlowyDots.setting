					ICS_ControlPage = "Dots",
				},
				DotCount = {
					LINKS_Name = "Dot Count",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Integer = true,
					INP_MinScale = 2,
					INP_MaxScale = 200,
					INP_Default = 50,
					ICS_ControlPage = "Dots",
				},
				LoopFrames = {
					LINKS_Name = "Speed (frames per loop)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Integer = true,
					INP_MinScale = 10,
					INP_MaxScale = 600,
					INP_Default = 150,
					ICS_ControlPage = "Animation",
				},
				Reverse = {
					LINKS_Name = "Reverse Direction",
					LINKID_DataType = "Number",
					INPID_InputControl = "CheckboxControl",
					INP_Integer = true,
					INP_Default = 0,
					ICS_ControlPage = "Animation",
				},
				Easing = {
					LINKS_Name = "Easing",
					LINKID_DataType = "Number",
					INPID_InputControl = "ComboControl",
					INP_Integer = true,
					INP_Default = 0,
					ICS_ControlPage = "Animation",
					{ CCS_AddString = "Linear" },
					{ CCS_AddString = "Ease In" },
					{ CCS_AddString = "Ease Out" },
					{ CCS_AddString = "Ease In-Out" },
				},
				GlowEnabled = {
					LINKS_Name = "Enable Glow",
					LINKID_DataType = "Number",
					INPID_InputControl = "CheckboxControl",
					INP_Integer = true,
					INP_Default = 1,
					ICS_ControlPage = "Glow",
				},
				BGEnabled = {
					LINKS_Name = "Enable Background Color",
					LINKID_DataType = "Number",
					INPID_InputControl = "CheckboxControl",
					INP_Integer = true,
					INP_Default = 0,
