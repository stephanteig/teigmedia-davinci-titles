					Default = 1,
					Page = "Dots",
				},
				DotBRGreen = InstanceInput {
					SourceOp = "DotColor",
					Source = "BottomRightGreen",
					ControlGroup = 4,
					Default = 0,
					Page = "Dots",
				},
				DotBRBlue = InstanceInput {
					SourceOp = "DotColor",
					Source = "BottomRightBlue",
					ControlGroup = 4,
					Default = 0,
					Page = "Dots",
				},
				DotGradient = InstanceInput {
					SourceOp = "DotColor",
					Source = "Gradient",
					Page = "Dots",
				},
				PathShape = InstanceInput {
					SourceOp = "DotPath",
					Source = "Polyline",
					Name = "Path Shape",
					Page = "Dots",
				},
				DotsPosition = InstanceInput {
					SourceOp = "DotsTransform",
